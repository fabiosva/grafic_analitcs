# ==============================================================================
# CRYPTO BOOM SCANNER (v2) - CONFIGURAÇÃO DE AMBIENTE
# ==============================================================================

# 1. Supabase / PostgreSQL (Obrigatório para nuvem / persistência)
# Pode ser copiado do seu dashboard do Supabase (Project Settings -> API)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_KEY=eyJh... # Use preferencialmente a service_role key para inserção no cron
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# 2. CoinGecko API
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY= # Opcional: Deixe em branco para usar o Free Tier (30 req/min)
TOTAL_COINS_TO_TRACK=350 # Top 300 a 500
COINGECKO_RATE_LIMIT_DELAY_MS=2500 # 2.5s entre chamadas no tier gratuito

# 3. Intervalo de Snapshot
SNAPSHOT_INTERVAL_MINUTES=60 # Intervalo horário (60 min)

# 4. Filtros de Exclusão Básica
MIN_MARKET_CAP_USD=1000000 # Excluir moedas com Market Cap < $1M
MIN_VOLUME_24H_USD=50000   # Excluir moedas com volume < $50k

# 5. Fator de Penalidade de Risco (Risk Penalty Weight)
# Calibrado: 0.50 (50%). Faixa recomendada: [0.30 a 0.70]
# Fórmula: Final Score = Opportunity Score - (Risk Score * RISK_PENALTY_FACTOR)
RISK_PENALTY_FACTOR=0.50

# 6. Alerta de Extensão (Filtro anti-FOMO)
EXTENDED_THRESHOLD_PCT=80.0 # Se subiu > +80% em 24h, sinaliza ⚠️ EXTENDED

# 7. Alertas no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_CHAT_ID=-1001234567890 # ID do grupo ou usuário
ALERT_THRESHOLD_SCORE=80.0 # Score mínimo para disparar alerta
ALERT_COOLDOWN_HOURS=8 # Intervalo mínimo para não repetir alerta da mesma moeda

# 8. Servidor Web
PORT=3000
